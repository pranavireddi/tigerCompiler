%%
%term
    EOF 
  | ID of string
  | INT of int | STRING of string 
  | COMMA | COLON | SEMICOLON | LPAREN | RPAREN | LBRACK | RBRACK 
  | LBRACE | RBRACE | DOT 
  | PLUS | MINUS | TIMES | DIVIDE | EQ | NEQ | LT | LE | GT | GE | UNARYMINUS
  | AND | OR | ASSIGN
  | ARRAY | IF | THEN | ELSE | WHILE | FOR | TO | DO | LET | IN | END | OF 
  | BREAK | NIL
  | FUNCTION | VAR | TYPE 

%nonterm  exp | program | expseq | arithmetic_exp 
         | comparison_exp | boolean_exp | record_creation | conditional_exp | while_exp 
         | for_exp | let_exp | decs | exp_list | dec | function_dec | param_list | param | var_dec 
         | type_dec | record_type | field_list | field | array_type | id_exp | id_options | lvalue_options
         | or_exp | and_exp | rel_exp | add_exp | mul_exp | unary_exp | primary_exp | relop


%pos int
%verbose
%start program
%eop EOF
%noshift EOF

%name Tiger

%keyword WHILE FOR TO BREAK LET IN END FUNCTION VAR TYPE ARRAY IF THEN ELSE 
	DO OF NIL

%prefer THEN ELSE LPAREN

%value ID ("bogus")
%value INT (1)
%value STRING ("")

%right UNARYMINUS
%nonassoc EQ NEQ LT LE GT GE
%left OR
%left AND
%left PLUS MINUS
%left TIMES DIVIDE

%%

program	: exp				()

exp : or_exp ()
    | record_creation ()
    | conditional_exp ()
    | while_exp ()
    | for_exp ()
    | let_exp ()
    | BREAK ()

or_exp
  : and_exp %prec OR ()
  | or_exp OR and_exp ()


and_exp
  : rel_exp %prec AND ()
  | and_exp AND rel_exp ()


rel_exp
  : add_exp %prec OR () 
  | add_exp relop add_exp ()


relop
  : EQ () | NEQ () | LT () | LE () | GT () | GE ()


add_exp
  : mul_exp %prec PLUS ()
  | add_exp PLUS mul_exp ()
  | add_exp MINUS mul_exp ()

mul_exp
  : unary_exp %prec TIMES ()
  | mul_exp TIMES unary_exp ()
  | mul_exp DIVIDE unary_exp ()


unary_exp
  : primary_exp ()
  | MINUS unary_exp %prec UNARYMINUS ()

primary_exp
  : id_exp ()
  | NIL () | INT () | STRING ()
  | LPAREN expseq RPAREN ()
  | LPAREN RPAREN ()

(* NOTE: Need to fix record creation *)
record_creation : LBRACE ID RBRACE	()

conditional_exp : IF exp THEN exp ELSE exp	()
    | IF exp THEN exp		()

while_exp : WHILE exp DO exp		()

for_exp : FOR ID ASSIGN exp TO exp DO exp	()

let_exp : LET decs IN expseq END	()

(* NOTE: need to group things to deal with mutual recursion *)

decs : ()
    | dec decs		()

dec : function_dec			()
    | var_dec			()
    | type_dec			()

function_dec : FUNCTION ID LPAREN RPAREN EQ exp ()
            | FUNCTION ID LPAREN param_list RPAREN EQ exp ()
            | FUNCTION ID LPAREN RPAREN COLON ID EQ exp ()
            | FUNCTION ID LPAREN param_list RPAREN COLON ID EQ exp ()

param_list : param			()
    | param COMMA param_list		()
param : ID COLON ID			()

var_dec: VAR ID ASSIGN exp		()
    | VAR ID COLON ID ASSIGN exp	()  

type_dec: TYPE ID EQ ID		()
    | TYPE ID EQ record_type	()
    | TYPE ID EQ array_type		()

record_type : LBRACE field_list RBRACE	()
field_list : field			()
    | field COMMA field_list		()
field : ID COLON ID			()  

array_type : ARRAY OF ID		()

(* NOTE: need some way of grouping lvalues and id stuff to make sure we don't have shift reduce issues. *)

id_exp : ID id_options ()

id_options
  : LPAREN exp_list RPAREN ()
  | LBRACK exp RBRACK OF exp ()
  | lvalue_options () 

lvalue_options
  : ()
  | DOT ID lvalue_options ()
  | LBRACK exp RBRACK lvalue_options ()



