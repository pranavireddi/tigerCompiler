

let
  type intArray = array of int
  type aliasInt = int

  var x := 0
  var y : int := 42
  var a : intArray := intArray[5] of 0

  function nop() = ()
  function id(n:int) : int = n
  function neg(n:int) : int = -n
  function add(p:int, q:int) : int = p + q
  function truthy(n:int) : int = if n then 1 else 0 

  function fact(n:int) : int =
    if n = 0 then 1 else n * fact(n - 1)

  function nestedLetTest(k:int) : int =
    let
      type localArr = array of int
      var t := localArr[2] of 7
      var z : int := (k; k + 1; k + 2) 
      function inner(m:int) : int = m + z
    in
      inner(t[0])  
    end

in

  ();

  (x + 1);

  (x := x + 1; x := x + 1; x);

  a[0] := 10;
  a[1] := a[0] * 2;

  x := 1 + 2 * 3;          
  x := (1 + 2) * 3;        
  x := -1 + 2;            
  x := -(1 + 2) * 3;    
  x := 10 / 2 / 5;      

  if 1 < 2 then x := 111 else x := 222;
  if 1 = 1 & 2 = 2 then x := 3 else x := 4;   
  if 0 | 1 then x := 5 else x := 6;         


  if 1 then
    if 0 then x := 7 else x := 8
  else
    x := 9;

  while x < 15 do (x := x + 1; ());

  for i := 0 to 3 do x := x + i;

  nop();
  x := id(123);
  x := add(1, 2);
  x := fact(5);
  x := nestedLetTest(10);

  let
    type matrix = array of intArray
    var m : matrix := matrix[2] of intArray[3] of 0
  in
    m[1][2] := 99;
    m[1][2]
  end

end
