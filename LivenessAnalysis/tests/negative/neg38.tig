/* Break-Condition Test */

let
    var x := 0
in
    /* 1. ILLEGAL: Break at the top level */
    break;

    /* 2. LEGAL: Standard while break */
    while 1 do (
        if x > 10 then break;
        x := x + 1
    );

    /* 3. LEGAL: Standard for break */
    for i := 0 to 10 do (
        if i = 5 then break
    );

    /* 4. ILLEGAL: Break inside a function body inside a loop.
       Even though 'f' is defined inside a loop, the break is 
       inside a function boundary, which is a no-go. */
    for i := 0 to 10 do (
        let 
            function f() = break 
        in 
            f() 
        end
    );

    /* 5. LEGAL: Nested loops.
       The break here should only exit the inner (j) loop. */
    while 1 do (
        for j := 0 to 10 do (
            if j = 5 then break;
            x := x + 1
        );
        if x > 100 then break
    );

    /* 6. LEGAL: Deeply nested break.
       Tests if loopDepth carries through let/if/expseq. */
    for i := 0 to 10 do (
        let var y := 0 in
            if y = 0 then (
                (x := x + 1; break)
            )
        end
    );

    /* 7. ILLEGAL: Break inside a let-declaration's initialization. */
    while 1 do (
        let var z := (break; 5) in print("fail") end
    );

    while 1 do (
        let function f() = break in f() end
    )
end