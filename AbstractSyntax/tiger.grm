structure A = Absyn

fun makeFieldFromID (namestr: string, typestr: string) :
  A.field = {
    name = Symbol.symbol namestr,
    escape = ref false,
    typ = Symbol.symbol typestr,
    pos = 0
  }


%%
%term
    EOF 
  | ID of string
  | INT of int | STRING of string 
  | COMMA | COLON | SEMICOLON | LPAREN | RPAREN | LBRACK | RBRACK 
  | LBRACE | RBRACE | DOT 
  | PLUS | MINUS | UMINUS | TIMES | DIVIDE | EQ | NEQ | LT | LE | GT | GE
  | AND | OR | ASSIGN
  | ARRAY | IF | THEN | ELSE | WHILE | FOR | TO | DO | LET | IN | END | OF 
  | BREAK | NIL
  | FUNCTION | VAR | TYPE 

%nonterm
    program
  | exp
  | lvalue
  | decs 
  | dec
  | arithmetic_exp
  | comparison_exp
  | boolean_exp
  | while_exp
  | for_exp
  | conditional_exp
  | array_exp
  | record_exp
  | record_field_list
  | record_field
  | function_dec 
  | param_list 
  | param 
  | var_dec 
  | type_dec 
  | record_type 
  | field_list 
  | field 
  | array_type 
  | expseq 
  | let_exp 
  | paren_exp 
  | function_call_exp 
  | let_inside 
  | fun_inside 
  | fun_options

%pos int
%verbose
%start program
%eop EOF
%noshift EOF

%name Tiger

%nonassoc ASSIGN
%nonassoc ID
%nonassoc WHILE DO

(* #NOTE: we always wanna read more if doing then or else bc cannot make decision yet *)
%right THEN
%right ELSE
%nonassoc LBRACK RBRACK OF

(* #NOTE: need to have OR lower precedence than AND *)
%left OR
%left AND
%nonassoc EQ NEQ LT LE GT GE
%left PLUS MINUS
%left TIMES DIVIDE
%left UMINUS

%keyword WHILE FOR TO BREAK LET IN END FUNCTION VAR TYPE ARRAY IF THEN ELSE 
         DO OF NIL

%prefer THEN ELSE LPAREN

%value ID ("bogus")
%value INT (1)
%value STRING ("")

%%

program: exp ()

exp: lvalue ()
  | NIL ()
  | INT ()
  | STRING ()
  | lvalue ASSIGN exp ()
  | paren_exp ()
  
  | array_exp ()
  | record_exp ()
  | let_exp ()

  | function_call_exp ()

  | MINUS exp %prec UMINUS ()
  | arithmetic_exp ()
  | comparison_exp ()
  | boolean_exp ()

  | conditional_exp ()
  | while_exp ()
  | for_exp ()
  | BREAK ()

lvalue: ID ()
  | lvalue DOT ID ()
  | ID LBRACK exp RBRACK ()
  | lvalue LBRACK exp RBRACK ()

array_exp: ID LBRACK exp RBRACK OF exp ()

record_exp: 
    ID LBRACE record_field_list RBRACE ()
  | ID LBRACE RBRACE ()

record_field_list: 
    record_field ()
  | record_field COMMA record_field_list ()

record_field: ID EQ exp ()

paren_exp: LPAREN exp RPAREN ()
  | LPAREN exp SEMICOLON exp expseq RPAREN ()
  | LPAREN RPAREN ()

arithmetic_exp: exp PLUS exp ()
  | exp MINUS exp ()
  | exp TIMES exp ()
  | exp DIVIDE exp ()

comparison_exp: exp EQ exp		()
    | exp NEQ exp		()
    | exp LT exp		()
    | exp LE exp		()
    | exp GT exp		()
    | exp GE exp		()

boolean_exp: exp AND exp ()
    | exp OR exp		()

while_exp: WHILE exp DO exp		()

for_exp: FOR ID ASSIGN exp TO exp DO exp	()

conditional_exp: IF exp THEN exp ELSE exp	()
    | IF exp THEN exp		()

function_call_exp: ID LPAREN fun_inside RPAREN		()

(* #NOTE: need similar logic to expseq for parsing function call arguments, since we need to be able to parse more if we see a comma, but also need to be able to stop if we see a right paren *)
fun_inside: exp fun_options ()
  | ()

fun_options: COMMA exp fun_options ()
  | ()
  
let_exp: LET decs IN let_inside END () 

(* #NOTE: weird issues with not parsing let correclty when just using expseq directly *)
let_inside: exp expseq ()
 | ()
  
decs: ()
    | dec decs		()

dec: function_dec			()
    | var_dec			    ()
    | type_dec			  ()

function_dec: FUNCTION ID LPAREN RPAREN EQ exp                      (A.FunctionDec([{name=Symbol.symbol $2, params=[], body=$6, resultTy=NONE, pos=FUNCTIONleft}]))
            | FUNCTION ID LPAREN param_list RPAREN EQ exp           (A.FunctionDec([{name=Symbol.symbol $2, params=$4, body=$7, resultTy=NONE, pos=FUNCTIONleft}]))
            | FUNCTION ID LPAREN RPAREN COLON ID EQ exp             (A.FunctionDec([{name=Symbol.symbol $2, params=[], body=$8, resultTy=SOME(Symbol.symbol $6, 0), pos=FUNCTIONleft}]))
            | FUNCTION ID LPAREN param_list RPAREN COLON ID EQ exp  (A.FunctionDec([{name=Symbol.symbol $2, params=$4, body=$9, resultTy=SOME(Symbol.symbol $7, 0), pos=FUNCTIONleft}]))

param_list: param			([$1])
    | param COMMA param_list		($1 :: $3)
param: ID COLON ID			(makeFieldFromID($1, $3))

var_dec: VAR ID ASSIGN exp		(A.VarDec{name=Symbol.symbol $2, escape=ref false, init=$4, pos=VARleft})
    | VAR ID COLON ID ASSIGN exp	(A.VarDec{name=Symbol.symbol $2, escape=ref false, init=$6, pos=VARleft})  

type_dec: TYPE ID EQ ID		(A.TypeDec([{name=Symbol.symbol $2, ty=A.NameTy(Symbol.symbol $4, 0), pos=TYPEleft}]))
    | TYPE ID EQ record_type	(A.TypeDec([{name=Symbol.symbol $2, ty=$4, pos=TYPEleft}]))
    | TYPE ID EQ array_type		(A.TypeDec([{name=Symbol.symbol $2, ty=$4, pos=TYPEleft}]))

record_type: LBRACE field_list RBRACE	(A.RecordTy($2))
    | LBRACE RBRACE (A.RecordTy([]))
field_list: field			([$1])
    | field COMMA field_list		($1 :: $3)
field: ID COLON ID			(makeFieldFromID($1, $3))  

array_type: ARRAY OF ID		(A.ArrayTy(Symbol.symbol $3, ARRAYleft))

expseq: SEMICOLON exp expseq ($2 :: $3)
  | ([])

