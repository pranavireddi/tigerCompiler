structure A = Absyn

%%
%term
    EOF 
  | ID of string
  | INT of int | STRING of string 
  | COMMA | COLON | SEMICOLON | LPAREN | RPAREN | LBRACK | RBRACK 
  | LBRACE | RBRACE | DOT 
  | PLUS | MINUS | UMINUS | TIMES | DIVIDE | EQ | NEQ | LT | LE | GT | GE
  | AND | OR | ASSIGN
  | ARRAY | IF | THEN | ELSE | WHILE | FOR | TO | DO | LET | IN | END | OF 
  | BREAK | NIL
  | FUNCTION | VAR | TYPE 

%nonterm
    program     of A.exp
  | exp         of A.exp
  | lvalue      of A.var
  | decs        of A.dec list
  | dec         of A.dec
  | arithmetic_exp of A.exp
  | comparison_exp of A.exp
  | boolean_exp of A.exp
  | while_exp of A.exp
  | for_exp of A.exp
  | conditional_exp of A.exp
  | array_exp of A.exp
  | record_exp of A.exp
  | record_field_list of (A.symbol * A.exp * A.pos) list
  | record_field of A.symbol * A.exp * A.pos
  | function_dec_group of A.fundec list
  | function_dec of A.fundec
  | param_list of A.field list
  | param of A.field
  | var_dec of A.dec
  | type_dec_group of {name: A.symbol, ty: A.ty, pos: A.pos} list
  | type_dec of {name: A.symbol, ty: A.ty, pos: A.pos}
  | record_type of A.ty
  | field_list of A.field list
  | field of A.field
  | array_type of A.ty
  | expseq of (A.exp * A.pos) list
  | let_exp of A.exp
  | paren_exp of A.exp
  | function_call_exp of A.exp
  | let_inside of (A.exp * A.pos) list
  | fun_inside of A.exp list
  | fun_options of A.exp list
  | not_func_dec of A.dec list
  | not_type_dec of A.dec list

%pos int
%verbose
%start program
%eop EOF
%noshift EOF

%name Tiger

%nonassoc ASSIGN
%nonassoc ID
%nonassoc WHILE DO

(* #NOTE: we always wanna read more if doing then or else bc cannot make decision yet *)
%right THEN
%right ELSE
%nonassoc LBRACK RBRACK OF

(* #NOTE: need to have OR lower precedence than AND *)
%left OR
%left AND
%nonassoc EQ NEQ LT LE GT GE
%left PLUS MINUS
%left TIMES DIVIDE
%left UMINUS

%keyword WHILE FOR TO BREAK LET IN END FUNCTION VAR TYPE ARRAY IF THEN ELSE 
         DO OF NIL

%prefer THEN ELSE LPAREN

%value ID ("bogus")
%value INT (1)
%value STRING ("")

%%

program: exp (exp)

exp: lvalue (A.VarExp(lvalue))
  | NIL (A.NilExp)
  | INT (A.IntExp(INT))
  | STRING (A.StringExp(STRING, STRINGleft))
  | lvalue ASSIGN exp (A.AssignExp{var=lvalue, exp=exp, pos=lvalueleft})
  | paren_exp (paren_exp)
  
  | array_exp (array_exp)
  | record_exp (record_exp)
  | let_exp (let_exp)

  | function_call_exp (function_call_exp)

  | MINUS exp %prec UMINUS (A.OpExp{left=A.IntExp(0), oper=A.MinusOp, right=exp, pos=MINUSleft})
  | arithmetic_exp (arithmetic_exp)
  | comparison_exp (comparison_exp)
  | boolean_exp (boolean_exp)

  | conditional_exp (conditional_exp)
  | while_exp (while_exp)
  | for_exp (for_exp)
  | BREAK (A.BreakExp(BREAKleft))

lvalue: ID (A.SimpleVar(Symbol.symbol ID, IDleft))
  | lvalue DOT ID (A.FieldVar(lvalue, Symbol.symbol ID, lvalueleft))
  | ID LBRACK exp RBRACK (A.SubscriptVar(A.SimpleVar(Symbol.symbol ID, IDleft), exp, IDleft))
  | lvalue LBRACK exp RBRACK (A.SubscriptVar(lvalue, exp, lvalueleft))

array_exp: ID LBRACK exp RBRACK OF exp (A.ArrayExp{typ=Symbol.symbol ID, size=exp1, init=exp2, pos=IDleft})

record_exp: 
    ID LBRACE record_field_list RBRACE (A.RecordExp{fields=record_field_list, typ=Symbol.symbol ID, pos=IDleft})
  | ID LBRACE RBRACE (A.RecordExp{fields=[], typ=Symbol.symbol ID, pos=IDleft})

record_field_list: 
    record_field ([record_field])
  | record_field COMMA record_field_list (record_field :: record_field_list)

record_field: ID EQ exp (Symbol.symbol ID, exp, IDleft)

paren_exp: LPAREN exp RPAREN (exp)
  | LPAREN exp SEMICOLON exp expseq RPAREN (A.SeqExp((exp1, exp1left) :: (exp2, exp2left) :: expseq))
  | LPAREN RPAREN (A.SeqExp([]))

arithmetic_exp: exp PLUS exp (A.OpExp{left=exp1, oper=A.PlusOp, right=exp2, pos=exp1left})
  | exp MINUS exp (A.OpExp{left=exp1, oper=A.MinusOp, right=exp2, pos=exp1left})
  | exp TIMES exp (A.OpExp{left=exp1, oper=A.TimesOp, right=exp2, pos=exp1left})
  | exp DIVIDE exp (A.OpExp{left=exp1, oper=A.DivideOp, right=exp2, pos=exp1left})

comparison_exp: exp EQ exp		(A.OpExp{left=exp1, oper=A.EqOp, right=exp2, pos=exp1left})
    | exp NEQ exp		(A.OpExp{left=exp1, oper=A.NeqOp, right=exp2, pos=exp1left})
    | exp LT exp		(A.OpExp{left=exp1, oper=A.LtOp, right=exp2, pos=exp1left})
    | exp LE exp		(A.OpExp{left=exp1, oper=A.LeOp, right=exp2, pos=exp1left})
    | exp GT exp		(A.OpExp{left=exp1, oper=A.GtOp, right=exp2, pos=exp1left})
    | exp GE exp		(A.OpExp{left=exp1, oper=A.GeOp, right=exp2, pos=exp1left})

boolean_exp: exp AND exp (A.IfExp{test=exp1, then'=exp2, else'=SOME(A.IntExp(0)), pos=exp1left})
    | exp OR exp		(A.IfExp{test=exp1, then'=A.IntExp(1), else'=SOME(exp2), pos=exp1left})

while_exp: WHILE exp DO exp		(A.WhileExp{test=exp1, body=exp2, pos=WHILEleft})

for_exp: FOR ID ASSIGN exp TO exp DO exp	(A.ForExp{var=Symbol.symbol ID, escape=ref true, lo=exp1, hi=exp2, body=exp3, pos=FORleft})

conditional_exp: IF exp THEN exp ELSE exp	(A.IfExp{test=exp1, then'=exp2, else'=SOME(exp3), pos=IFleft})
    | IF exp THEN exp		(A.IfExp{test=exp1, then'=exp2, else'=NONE, pos=IFleft})

function_call_exp: ID LPAREN fun_inside RPAREN		(A.CallExp{func=Symbol.symbol ID, args=fun_inside, pos=IDleft})

(* #NOTE: need similar logic to expseq for parsing function call arguments, since we need to be able to parse more if we see a comma, but also need to be able to stop if we see a right paren *)
fun_inside: exp fun_options (exp :: fun_options)
  | ([])

fun_options: COMMA exp fun_options (exp :: fun_options)
  | ([])
  
let_exp: LET decs IN let_inside END (A.LetExp{decs=decs, body=A.SeqExp(let_inside), pos=LETleft}) 

(* #NOTE: weird issues with not parsing let correclty when just using expseq directly *)
let_inside: exp expseq ((exp, expleft) :: expseq)
 | ([])
  
(* allows for 0 or more declarations in a sequence. *)
(* decs: ([])
    | dec decs		(dec :: decs) *)
(* 
#NOTE: so we need to make sure that we can have groups of functions and types bc of mutual recursion.
like this is needed when we do the two pass filling in of headers in the type checker. our prev code only supported singleton
declarations of functions and types, which is wrong! :'( *)
decs: function_dec_group not_func_dec		(A.FunctionDec(function_dec_group) :: not_func_dec)
    | var_dec	decs		        (var_dec :: decs)
    | type_dec_group	not_type_dec		(A.TypeDec(type_dec_group) :: not_type_dec)
    | ([])

(* #NOTE: this is the main logic for handling the mutual recursion issues. i was thinking that adding strict rules that
we keep parsing func decs until we see a type or var dec. this helps with the ambiguity we had earlier abt whether
to continue to parse or just reduce. same with type. *)
not_func_dec: var_dec decs (var_dec :: decs)
              | type_dec_group not_type_dec (A.TypeDec(type_dec_group) :: not_type_dec)
              | ([])

not_type_dec: var_dec decs (var_dec :: decs)
              | function_dec_group	not_func_dec	(A.FunctionDec(function_dec_group) :: not_func_dec)
              | ([])

(* NOTE: the reson that this does not work bc this grammar is not clear abt whether we should reduce after seeing a single func dec
or if we should keep shifting to parse more. 
function_dec_group: function_dec ([function_dec])
                  | function_dec function_dec_group (function_dec :: function_dec_group) *)

(* #NOTE: do not need tail stuff since i'm p sure we have LR parsing here *)
function_dec_group: FUNCTION function_dec ([function_dec])
                  | FUNCTION function_dec function_dec_group (function_dec :: function_dec_group)


(* #NOTE: got rid of FUNCTION here bc we just move that into our function_dec_group logic to help deal with figuring out if we should parse more or reduce *)
function_dec: ID LPAREN RPAREN EQ exp ({name=Symbol.symbol ID, params=[], result=NONE, body=exp, pos=IDleft})
            | ID LPAREN param_list RPAREN EQ exp ({name=Symbol.symbol ID, params=param_list, result=NONE, body=exp, pos=IDleft})
            | ID LPAREN RPAREN COLON ID EQ exp ({name=Symbol.symbol ID1, params=[], result=SOME(Symbol.symbol ID2, ID2left), body=exp, pos=ID1left})
            | ID LPAREN param_list RPAREN COLON ID EQ exp ({name=Symbol.symbol ID1, params=param_list, result=SOME(Symbol.symbol ID2, ID2left), body=exp, pos=ID1left})

param_list: param			([param])
    | param COMMA param_list		(param :: param_list)
param: ID COLON ID			({name=Symbol.symbol ID1, escape=ref true, typ=Symbol.symbol ID2, pos=ID1left})

var_dec: VAR ID ASSIGN exp		(A.VarDec{name=Symbol.symbol ID, escape=ref true, typ=NONE, init=exp, pos=VARleft})
    | VAR ID COLON ID ASSIGN exp	(A.VarDec{name=Symbol.symbol ID1, escape=ref true, typ=SOME(Symbol.symbol ID2, ID2left), init=exp, pos=VARleft})  

(* #NOTE: same issue as w function dec! need to be able to deterministically decide whether to keep parsing or stop.
key logic for this is actually handled in the decs part to enforce strict rules abt when you must keep parsing (basically when 
you see continuous TYPE or FUNCTION keywords.) i think this might work for now. @alisha maybe take a look later *)
(* type_dec_group: type_dec ([type_dec])
              | type_dec type_dec_group (type_dec :: type_dec_group) *)

type_dec_group: TYPE type_dec ([type_dec])
              | TYPE type_dec type_dec_group (type_dec :: type_dec_group)

type_dec: ID EQ ID		({name=Symbol.symbol ID1, ty=A.NameTy(Symbol.symbol ID2, ID2left), pos=ID1left})
    | ID EQ record_type	({name=Symbol.symbol ID, ty=record_type, pos=IDleft})
    | ID EQ array_type		({name=Symbol.symbol ID, ty=array_type, pos=IDleft})

record_type: LBRACE field_list RBRACE	(A.RecordTy(field_list))
    | LBRACE RBRACE (A.RecordTy([]))
field_list: field			([field])
    | field COMMA field_list		(field :: field_list)
field: ID COLON ID			({name=Symbol.symbol ID1, escape=ref true, typ=Symbol.symbol ID2, pos=ID1left})  

array_type: ARRAY OF ID		(A.ArrayTy(Symbol.symbol ID, IDleft))

expseq: SEMICOLON exp expseq ((exp, expleft) :: expseq)
  | ([])
