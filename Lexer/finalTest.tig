let
    type rectype = {name:string, age:int}
    var rec1:rectype := rectype {name="Bob", age=42}
in
    rec1.name := "Alice";
    rec1
end

let
    var x : int := 5
    var y : string := "hello"
in
    if x > 0 then
        y := "positive"
    else
        y := "not positive"
end